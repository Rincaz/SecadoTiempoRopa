<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Datos de la Raspberry Pi"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp" />

    <TextView
        android:id="@+id/tvClima"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Cargando clima..."
        android:textSize="18sp"
        android:layout_marginTop="16dp" />

    <TextView
        android:id="@+id/tvRecomendacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Calculando mejor hora..."
        android:textColor="#009688"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginTop="24dp" />

    <TextView
        android:id="@+id/tvTiempoSecado"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tiempo estimado: --"
        android:textSize="18sp"
        android:layout_marginTop="16dp" />
</LinearLayout>