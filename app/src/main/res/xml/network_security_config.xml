<?xml version="1.0" encoding="utf-8"?>
<!-- 3.1.1.1 / 3.1.4.11: sólo tráfico cifrado (TLS) y sólo autoridades de certificación del sistema. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
