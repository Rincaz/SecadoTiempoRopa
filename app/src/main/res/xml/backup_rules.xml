<?xml version="1.0" encoding="utf-8"?>
<!-- 3.1.4.12: ningún dato local (cola, caché, preferencias) sale del equipo mediante copias de seguridad. -->
<full-backup-content>
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
</full-backup-content>
